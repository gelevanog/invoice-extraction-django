# Copy to .env and adjust. Every variable is optional; the defaults run the whole
# pipeline offline with the deterministic `fake` LLM provider.

# --- Django --------------------------------------------------------------------------
# Secret key for sessions/CSRF. MUST be set to a long random value in production.
DJANGO_SECRET_KEY=change-me
# true = debug pages and media served by Django (local development only).
DJANGO_DEBUG=true
# Comma-separated host names the app may serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins for CSRF when served behind HTTPS/another domain (e.g. https://docs.example.com).
DJANGO_CSRF_TRUSTED_ORIGINS=
# Database URL. Defaults to SQLite (db.sqlite3). docker-compose uses PostgreSQL.
DATABASE_URL=sqlite:///db.sqlite3
# Where uploaded documents are stored.
MEDIA_ROOT=./media
# Maximum upload size in megabytes.
MAX_UPLOAD_MB=20
# Page size for list endpoints of the REST API.
API_PAGE_SIZE=25
TIME_ZONE=UTC

# --- Background processing -----------------------------------------------------------
# true = tasks run inline in the web process (no Redis/worker needed).
CELERY_TASK_ALWAYS_EAGER=true
# Broker used when eager mode is off.
CELERY_BROKER_URL=redis://localhost:6379/0

# --- LLM -----------------------------------------------------------------------------
# fake | anthropic | openai | openrouter. `fake` is a deterministic offline extractor (no key needed).
LLM_PROVIDER=fake
# Required only for LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Required only for LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Required only for LLM_PROVIDER=openrouter (OpenAI-compatible gateway; ":free" models cost nothing).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
# Comma-separated models OpenRouter tries in order when the primary is rate-limited or down.
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
# Optional attribution headers (HTTP-Referer / X-Title) shown on openrouter.ai.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=DocExtract
# SDK retries on 429 / 5xx / connection errors (exponential backoff, honours Retry-After).
LLM_MAX_RETRIES=2
# Minimum seconds between LLM requests per process; ~3 on free tiers (about 20 requests/min).
LLM_MIN_INTERVAL_SECONDS=0
# Seconds before an LLM request times out.
LLM_TIMEOUT_SECONDS=120
# Attempts per document when the model output fails schema validation (errors are fed back).
LLM_MAX_ATTEMPTS=3

# --- OCR (scanned PDFs, photos, image attachments) -----------------------------------
# tesseract (local, needs the tesseract-ocr package; the Docker image has it)
# | vision (the LLM above transcribes page images; needs anthropic or openai)
# | none (scans and images are rejected with a clear error).
OCR_ENGINE=tesseract
# Tesseract language packs to use, joined with "+", e.g. eng+deu (install tesseract-ocr-deu).
OCR_LANGUAGES=eng
# Resolution PDF pages without a text layer are rendered at before OCR.
OCR_DPI=300
# Pages whose mean OCR word confidence is below this are flagged and sent to review.
OCR_MIN_CONFIDENCE=0.65

# --- Learning from reviewer corrections ----------------------------------------------
# Verified documents of the same vendor shown to the model as few-shot examples (0 = off).
FEWSHOT_MAX_EXAMPLES=3
# Character budget for those examples in the prompt (roughly 4 characters per token).
FEWSHOT_MAX_CHARS=4000

# --- Validation & routing ------------------------------------------------------------
# Any routed field or line item below this confidence goes to the review queue.
REVIEW_CONFIDENCE_THRESHOLD=0.75
# true = warnings (not only errors) also send records to review.
REVIEW_ON_WARNINGS=false
# true = the first invoice from an unknown vendor always needs a human.
REVIEW_NEW_VENDORS=false
# Absolute tolerance for sum checks (line items vs subtotal, subtotal + tax vs total).
AMOUNT_TOLERANCE=0.02

# --- Enrichment ----------------------------------------------------------------------
# 0-100 rapidfuzz score needed to link an extracted vendor name to an existing vendor.
VENDOR_MATCH_THRESHOLD=85
# Currency all totals are converted to.
BASE_CURRENCY=EUR
# static (bundled JSON table) | frankfurter (live ECB rates, free, no key).
FX_PROVIDER=static
# Optional path to your own static rates JSON ({"base": "EUR", "rates": {...}}).
FX_RATES_FILE=
# Base URL for FX_PROVIDER=frankfurter.
FX_API_URL=https://api.frankfurter.dev/v1
# keyword (deterministic) | llm (one LLM call per invoice, falls back to keywords).
LINE_ITEM_CATEGORIZER=keyword

# --- Logging -------------------------------------------------------------------------
LOG_LEVEL=INFO
# console (human-readable) | json (one JSON object per line, for log shippers).
LOG_FORMAT=console

# --- Demo ----------------------------------------------------------------------------
# `manage.py seed_demo` creates/updates a superuser "demo" with this password when set.
DEMO_USER_PASSWORD=demo
# docker-compose only: host port for the web UI, and whether to seed demo data on start.
WEB_PORT=8000
SEED_DEMO=true
